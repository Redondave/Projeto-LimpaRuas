    <data key="d0">EPSG:31983</data>
    <data key="d1">gama_area_estudo_osm.graphml</data>
    <data key="d2">Grafo do Gama atribuido para alocacao de trafego (Frank-Wolfe)</data>
    <data key="d3">2026-10-15</data>
    <data key="d4">Tables/matriz_od_final.json</data>
    <data key="d5">length m; v0_kmh, limite_kmh, vmed_kmh, v_madrugada_kmh km/h; t0_min, t_obs_min min; capacidade_*, fluxo_atual_estimado_veic_h veic/h por sentido</data>
    <data key="d6">capacidade_veic_h = efetiva nos gargalos (gargalo = True, fator adotado), nominal nas demais; capacidade_veic_h_fator_min/_max para os outros fatores de expansao; outros alpha/beta: recalcular com enrich_graph.capacidade_efetiva</data>
    <data key="d7">{"min": 8.82, "adotado": 12.21, "max": 21.96}</data>
    <data key="d8">BPR: t = t0_min * (1 + bpr_alpha * (fluxo / capacidade_veic_h) ** bpr_beta)</data>
    <data key="d9">0.15</data>
    <data key="d10">4.0</data>
    <data key="d11">min(limite, max(v_madrugada 00-04h, v_pico)); sem dado de madrugada, o limite</data>
    <data key="d12">k_inicial = vmed_kmh / limite_kmh (pico)</data>
    <data key="d13">arestas com permite_carro = False</data>
    <data key="d14">nx.read_graphml (ox.load_graphml nao aceita os atributos tipados)</data>
  </graph>
</graphml>
